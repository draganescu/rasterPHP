# Apache for a Raster site. `php bin/raster deploy --config=apache` prints
# this file; the rules come from system/private_paths.php.

RewriteEngine on

# Never serve code, configuration, data or tooling directly
# dotfiles and dot folders: .git, .env, .htaccess, .github
RewriteRule (^|/)\. - [F,L]
# the framework, the command line and the test suites
RewriteRule ^(system|bin|tests)(/|$) - [F,L]
# each app's settings, models, database and translations
RewriteRule ^[^/]+/(config|models|data|i18n)(/|$) - [F,L]
# view files are pages, not downloads
RewriteRule ^[^/]+/views/.*\.(html|rss|atom|xml|json|txt)$ - [F,L]
# code, databases, dumps and notes, wherever they are (index.php excepted)
RewriteRule ^(?!index\.php$).*\.(php|phar|sqlite|sql|md|lock|ini|bak)$ - [F,L]
# SQLite's journal, write-ahead log and shared memory files
RewriteRule -(journal|wal|shm)$ - [F,L]

# everything else is the site
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule . index.php [L]
