RewriteEngine on

# Never serve code, configuration, data or tooling directly
RewriteRule (^|/)\. - [F,L]
RewriteRule ^(system|bin|tests)(/|$) - [F,L]
RewriteRule ^application/(config|models|data)(/|$) - [F,L]
RewriteRule ^application/views/.*\.(html|rss|atom|xml|json|txt)$ - [F,L]
RewriteRule ^(?!index\.php$).*\.(php|sqlite|sql|md)$ - [F,L]
RewriteRule -(journal|wal|shm)$ - [F,L]

RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule . index.php [L]
