#!/usr/bin/env php
<?php
// Raster command line
//
//   php bin/raster lint [--json] [--theme=name] [--all-themes]
//   php bin/raster schema [--json] [--check] [--apply] [--rename=table.old:new] [--drop=table.column]
//   php bin/raster user <username> [--password=secret]
//   php bin/raster mcp
//   php bin/raster serve [--port=8000]
//   php bin/raster render <url>
//   php bin/raster new <folder>
//   php bin/raster update [latest|<version>|<branch>|<folder>|<file.tar.gz>] [--dry-run] [--force]
//   php bin/raster upgrade [--dry-run]
//   php bin/raster doctor [--json]
//   php bin/raster version

if (PHP_SAPI !== 'cli') exit;

$root = dirname(__DIR__);
require_once $root.'/system/boot.php';
boot::$appname = getenv('RASTER_APP') ?: 'application';

$args = array_slice($argv, 1);
$command = array_shift($args) ?: 'help';
$options = array();
$positional = array();
foreach ($args as $arg) {
	if (preg_match('/^--([a-z\-]+)(?:=(.*))?$/', $arg, $m)) {
		$key = $m[1];
		$value = isset($m[2]) ? $m[2] : true;
		if (isset($options[$key])) $options[$key] = array_merge((array)$options[$key], array($value));
		else $options[$key] = $value;
	} else {
		$positional[] = $arg;
	}
}

// creating and updating projects happens before any app boots
if (in_array($command, array('new', 'update', 'version'))) {
	require_once $root.'/system/tools/project.php';
	$color = function_exists('posix_isatty') && posix_isatty(STDOUT) && !getenv('NO_COLOR');
	$paint = function ($text, $code) use ($color) { return $color ? "\033[{$code}m$text\033[0m" : $text; };
	try {
		exit(raster_project_command($command, $root, $positional, $options, $paint));
	} catch (Exception $e) {
		fwrite(STDERR, $paint('error', '31').': '.$e->getMessage()."\n");
		exit(1);
	}
}

function raster_project_command($command, $root, $positional, $options, $paint) {
	switch ($command) {
	case 'version':
		echo 'Raster '.raster_project::version($root)."\n";
		foreach (raster_project::apps($root) as $app) {
			echo "  $app/ is at ".raster_project::app_version("$root/$app")."\n";
		}
		return 0;

	case 'new':
		if (empty($positional[0])) {
			fwrite(STDERR, "Usage: php bin/raster new <folder>\n");
			return 2;
		}
		$target = rtrim($positional[0], '/');
		raster_project::create($root, $target);
		echo "Created a Raster ".raster_project::version($root)." site in $target\n\n";
		echo "  cd ".escapeshellarg($target)."\n  php bin/raster serve\n\nAGENTS.md explains the rest.\n";
		return 0;

	case 'update':
		$source = isset($positional[0]) ? $positional[0] : 'latest';
		$work = sys_get_temp_dir().'/raster-update-'.getmypid();
		mkdir($work, 0775, true);
		register_shutdown_function(function () use ($work) { exec('rm -rf '.escapeshellarg($work)); });
		echo "Getting Raster ($source)…\n";
		$release = raster_project::fetch($source, $work);
		$old = raster_project::version($root);
		$new = raster_project::version($release);
		if (version_compare($new, $old, '<') && !isset($options['force'])) {
			fwrite(STDERR, "That is Raster $new, older than this project's $old. Pass --force to go back anyway.\n");
			return 1;
		}
		$edits = raster_project::edits($root);
		if (raster_project::has_edits($edits)) {
			echo $paint('These framework files were edited since they were installed:', '33')."\n";
			foreach (array('changed', 'missing', 'added') as $kind) foreach ($edits[$kind] as $path) echo "  $kind  $path\n";
			echo "An update replaces them. Move the changes into your app (a the_<model> override,\nconfig/the_*.php or the_<file>.php; see AGENTS.md, Extending).\n";
			if (!isset($options['force'])) {
				echo "Nothing was changed. Pass --force to update anyway (the old files are kept in a backup).\n";
				return 1;
			}
		} elseif ($edits === null) {
			echo "There is no record of the framework files as installed, so edits can't be detected; the old files are kept in a backup.\n";
		}
		$plan = raster_project::plan($root, $release);
		$total = count($plan['add']) + count($plan['change']) + count($plan['remove']);
		echo "Raster $old → $new: ".count($plan['change'])." changed, ".count($plan['add'])." new, ".count($plan['remove'])." removed file(s)\n";
		if (isset($options['dry-run'])) {
			foreach (array('change' => '~', 'add' => '+', 'remove' => '-') as $kind => $mark) foreach ($plan[$kind] as $path) echo "  $mark $path\n";
			foreach (raster_project::upgrade_files($release, $old, $new) as $version => $file) echo "  upgrade steps for $version will run\n";
			return 0;
		}
		$apps = raster_project::apps($root);
		$backup_app = in_array(getenv('RASTER_APP') ?: 'application', $apps) ? (getenv('RASTER_APP') ?: 'application') : (isset($apps[0]) ? $apps[0] : null);
		if ($total === 0) {
			raster_project::record($root);
			echo "Already up to date.\n";
		} else {
			if ($backup_app === null) throw new RuntimeException('No app folder to keep the backup in');
			$backup = raster_project::update($root, $release, $backup_app);
			echo $paint("Updated to Raster $new.", '32').($backup ? " The replaced files are in ".substr($backup, strlen($root) + 1)."/" : '')."\n";
		}
		// the new code upgrades each app
		$failed = 0;
		foreach ($apps as $app) {
			$env = array_merge(getenv(), array('RASTER_APP' => $app));
			$process = proc_open(array(PHP_BINARY, $root.'/bin/raster', 'upgrade'), array(1 => STDOUT, 2 => STDERR), $pipes, $root, $env);
			if (proc_close($process) !== 0) $failed++;
		}
		echo "\nNext: php bin/raster doctor, and your tests. CHANGELOG.md lists what changed.\n";
		return $failed ? 1 : 0;
	}
	return 2;
}

// `render` boots with the requested URL; everything else needs no request
if ($command !== 'render') {
	boot::cli();
	require_once BASE.'tools/inspector.php';
	require_once BASE.'tools/schema.php';
}

$color = function_exists('posix_isatty') && posix_isatty(STDOUT) && !getenv('NO_COLOR');
$paint = function ($text, $code) use ($color) { return $color ? "\033[{$code}m$text\033[0m" : $text; };
$json = function ($data) { echo json_encode($data, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE)."\n"; };

switch ($command) {

	case 'lint':
		$inspector = new raster_inspector(null, isset($options['theme']) && is_string($options['theme']) ? $options['theme'] : null);
		$themes = null;
		if (isset($options['all-themes'])) {
			$themes = array_values(array_filter(scandir($inspector->views_dir), function ($d) use ($inspector) {
				return $d[0] !== '.' && is_dir($inspector->views_dir.'/'.$d);
			}));
		}
		$problems = $inspector->lint($themes ?: array($inspector->theme));
		$errors = count(array_filter($problems, function ($p) { return $p['severity'] === 'error'; }));
		if (isset($options['json'])) {
			$json(array('errors' => $errors, 'warnings' => count($problems) - $errors, 'problems' => $problems));
		} else {
			foreach ($problems as $p) {
				$label = $p['severity'] === 'error' ? $paint('error', '31') : $paint('warning', '33');
				echo "{$p['file']}:{$p['line']}:{$p['column']}: $label: {$p['message']}\n";
			}
			$names = $themes ?: array($inspector->theme);
			$views = 0;
			foreach ($names as $name) $views += count($inspector->views($name));
			echo $problems ? "\n" : '';
			echo ($errors ? $paint("$errors error(s)", '31') : $paint('No errors', '32')).', '.(count($problems) - $errors)." warning(s) in ".(count($names) > 1 ? 'themes ' : 'theme ')."'".implode("', '", $names)."' ($views views)\n";
		}
		exit($errors ? 1 : 0);

	case 'schema':
		$schema = new raster_schema();
		try {
			$output = array();
			foreach ((array)($options['rename'] ?? array()) as $rename) {
				if (!preg_match('/^([a-z0-9]+)\.([a-z0-9_]+):([a-z0-9_]+)$/', (string)$rename, $m)) {
					fwrite(STDERR, "--rename takes table.old:new, e.g. --rename=newsdata.title:headline\n");
					exit(2);
				}
				$output[] = $schema->rename($m[1], $m[2], $m[3]);
			}
			foreach ((array)($options['drop'] ?? array()) as $drop) {
				if (!preg_match('/^([a-z0-9]+)(?:\.([a-z0-9_]+))?$/', (string)$drop, $m)) {
					fwrite(STDERR, "--drop takes table.column or table, e.g. --drop=newsdata.subtitle\n");
					exit(2);
				}
				$output[] = $schema->drop($m[1], isset($m[2]) ? $m[2] : null, isset($options['force']));
			}
			if (isset($options['apply'])) {
				$output = array_merge($output, $schema->apply());
			}
			$status = $schema->status();
		} catch (Exception $e) {
			fwrite(STDERR, $paint('error', '31').': '.$e->getMessage()."\n");
			exit(1);
		}

		if (isset($options['json'])) {
			$json(array('changes' => $output) + $status);
		} else {
			foreach ($output as $line) echo $paint('✓', '32')." $line\n";
			if ($output) echo "\n";
			echo "Environment: {$status['environment']}".($status['frozen'] ? ' (frozen)' : ' (fluid: new fields are created on the next request)')."\n\n";
			foreach ($status['tables'] as $table) {
				$title = $table['kind'] === 'page'
					? "page {$table['url']}  ({$table['view']})"
					: "collection {$table['name']}  (used in ".implode(', ', $table['views']).")";
				$state = $table['exists'] ? "{$table['rows']} row(s)" : ($table['fields'] ? $paint('not in database', '33') : 'no page fields');
				echo $paint($title, '1')."  table {$table['table']}, $state\n";
				foreach ($table['fields'] as $name => $field) {
					$default = preg_replace('/\s+/', ' ', strip_tags($field['default']));
					if (mb_strlen($default) > 50) $default = mb_substr($default, 0, 47).'...';
					$mark = $field['in_database'] ? $paint('✓', '32') : $paint('+', '33');
					echo "  $mark $name".($default !== '' ? $paint("  \"$default\"", '2') : '')."\n";
				}
				foreach ($table['orphans'] as $orphan) {
					echo '  '.$paint('-', '31')." $orphan ".$paint('(in database, not in any template)', '2')."\n";
				}
				foreach ($table['rename_candidates'] as $rename) {
					echo '    '.$paint("renamed? php bin/raster schema --rename={$table['table']}.{$rename['from']}:{$rename['to']}", '36')."\n";
				}
			}
			foreach ($status['system_tables'] as $table) {
				if ($table['missing']) {
					echo $paint("table {$table['table']}", '1').'  '.$paint(($table['exists'] ? 'missing '.implode(', ', $table['missing']) : 'not in database').($status['frozen'] ? ' (run --apply)' : ' (created when first used)'), '33')."\n";
				}
			}
			if ($status['environment'] === 'production' && !$status['site_url']) {
				echo $paint('Set RASTER_URL (or config site_url) to the site address: emails with links are not sent without it.', '33')."\n";
			}
			foreach ($status['unused_tables'] as $table) {
				echo $paint("table $table", '1')."  ".$paint("not used by any template (php bin/raster schema --drop=$table)", '2')."\n";
			}
			echo "\n";
			if ($status['drift']) {
				echo $paint('The database and the templates differ.', '33');
				echo $status['frozen'] ? " Run `php bin/raster schema --apply` to add missing tables and columns.\n" : "\n";
			} else {
				echo $paint('The database matches the templates.', '32')."\n";
			}
		}
		exit(isset($options['check']) && $status['drift'] ? 1 : 0);

	case 'user':
		$login = isset($positional[0]) ? $positional[0] : null;
		if (!$login) {
			fwrite(STDERR, "Usage: php bin/raster user <email or username> [--password=secret] [--role=admin|editor|member] [--name=\"Ada Lovelace\"]\n");
			exit(2);
		}
		$role = isset($options['role']) && is_string($options['role']) ? $options['role'] : 'admin';
		$password = isset($options['password']) && is_string($options['password']) ? $options['password'] : bin2hex(random_bytes(9));
		$was_frozen = database::$frozen;
		try {
			authentication::connect();
			R::freeze(false);
			authentication::save_user($login, $password, $role, isset($options['name']) && is_string($options['name']) ? $options['name'] : null);
		} catch (Exception $e) {
			fwrite(STDERR, $paint('error', '31').': '.$e->getMessage()."\n");
			exit(1);
		} finally {
			R::freeze($was_frozen);
		}
		echo "User '$login' saved as $role.".(isset($options['password']) ? '' : " Password: $password")."\n";
		echo "Log in at ".rtrim(config::get('link_uri'), '/')."/login\n";
		exit(0);

	case 'users':
		authentication::connect();
		$users = authentication::table_ready() ? R::findAll('user', ' ORDER BY id ') : array();
		foreach ($users as $user) {
			printf("%-4d %-8s %-30s %s\n", $user->id, $user->role, $user->email ?: $user->username, $user->last_login ? 'last login '.$user->last_login : 'never logged in');
		}
		if (!$users) echo "No users. Create one with: php bin/raster user admin\n";
		exit(0);

	case 'send':
		// sends a page of the site as a newsletter issue
		$url = isset($positional[0]) ? $positional[0] : null;
		if (!$url) {
			fwrite(STDERR, "Usage: php bin/raster send <url> [--to=email] [--subject=...] [--dry-run] [--again]\n");
			exit(2);
		}
		if (!getenv('RASTER_URL') && !config::get('site_url')) {
			fwrite(STDERR, "Set RASTER_URL to the site address (e.g. RASTER_URL=https://example.com/) so links in the email point to the site.\n");
			exit(2);
		}
		$env = getenv();
		$env['RASTER_SENDING'] = '1';
		$process = proc_open(array(PHP_BINARY, __FILE__, 'render', $url), array(1 => array('pipe', 'w'), 2 => array('pipe', 'w')), $pipes, $root, $env);
		$html = stream_get_contents($pipes[1]);
		$errors = stream_get_contents($pipes[2]);
		if (proc_close($process) !== 0) {
			fwrite(STDERR, $paint('error', '31').": $url did not render: ".trim($errors)."\n");
			exit(1);
		}
		$html = newsletter::prepare_issue($html);
		$subject = isset($options['subject']) && is_string($options['subject']) ? $options['subject'] : newsletter::subject_of($html);
		if ($subject === '') {
			fwrite(STDERR, "The page has no <title>; pass --subject=\"...\"\n");
			exit(2);
		}
		if (strpos($html, newsletter::MARKER) === false) {
			fwrite(STDERR, $paint('warning', '33').": the page has no unsubscribe link (<!-- print.newsletter.unsubscribe_url /-->); readers can only use their mail app's unsubscribe button\n");
		}
		if (isset($options['to'])) {
			$ok = newsletter::deliver($html, $subject, (string)$options['to'], '');
			echo $ok ? "Sent \"$subject\" to {$options['to']} (".mail::transport().")\n" : $paint('error', '31').': '.mail::$last_error."\n";
			exit($ok ? 0 : 1);
		}
		newsletter::connect();
		$sent_before = in_array('newsletterissue', R::inspect()) ? R::findOne('newsletterissue', ' url = ? ', array($url)) : null;
		if ($sent_before && !isset($options['again'])) {
			fwrite(STDERR, "$url was already sent on {$sent_before->sent_at} to {$sent_before->recipients} subscribers. Use --again to send it again.\n");
			exit(1);
		}
		$subscribers = newsletter::subscribers();
		if (isset($options['dry-run'])) {
			echo "Would send \"$subject\" to ".count($subscribers)." subscriber(s) via ".mail::transport()."\n";
			exit(0);
		}
		$ok = 0; $failed = 0;
		foreach ($subscribers as $subscriber) {
			if (newsletter::deliver($html, $subject, $subscriber->email, $subscriber->token)) $ok++;
			else { $failed++; fwrite(STDERR, "  {$subscriber->email}: ".mail::$last_error."\n"); }
		}
		$was_frozen = database::$frozen;
		R::freeze(false);
		$issue = R::dispense('newsletterissue');
		$issue->url = $url;
		$issue->subject = $subject;
		$issue->recipients = $ok;
		$issue->sent_at = R::isoDateTime();
		R::store($issue);
		R::freeze($was_frozen);
		echo "Sent \"$subject\" to $ok subscriber(s)".($failed ? ", $failed failed" : '')." via ".mail::transport()."\n";
		exit($failed ? 1 : 0);

	case 'upgrade':
		require_once BASE.'tools/project.php';
		$app = boot::$appname;
		$pending = raster_project::pending($root, $app);
		$to = raster_project::version($root);
		if (isset($options['dry-run'])) {
			if (!$pending) echo "$app/ needs no upgrade steps\n";
			foreach ($pending as $step) echo "  {$step['version']} {$step['id']}: {$step['description']}\n";
			exit(0);
		}
		$done = raster_project::upgrade($root, $app);
		foreach ($done as $step) echo "  ✓ {$step['version']} {$step['id']}: {$step['description']}".($step['result'] !== '' ? " ({$step['result']})" : '')."\n";
		echo "$app/ is at Raster $to".($done ? '' : ', nothing to change')."\n";
		exit(0);

	case 'doctor':
		require_once BASE.'tools/project.php';
		$checks = raster_project::doctor($root, boot::$appname, config::get('environment'));
		$fails = count(array_filter($checks, function ($c) { return $c['status'] === 'fail'; }));
		if (isset($options['json'])) {
			$json(array('environment' => config::get('environment'), 'failures' => $fails, 'checks' => $checks));
			exit($fails ? 1 : 0);
		}
		echo "Checking ".boot::$appname."/ in ".config::get('environment')."\n\n";
		foreach ($checks as $c) {
			$mark = array('ok' => $paint('✓', '32'), 'warn' => $paint('!', '33'), 'fail' => $paint('✗', '31'));
			echo $mark[$c['status']].' '.$c['title']."\n";
			if ($c['detail'] !== '' && $c['status'] !== 'ok') echo '    '.str_replace("\n", "\n    ", $c['detail'])."\n";
		}
		echo "\n".($fails ? $paint("$fails problem(s) to fix", '31') : $paint('Ready', '32'))."\n";
		exit($fails ? 1 : 0);

	case 'mcp':
		controller::load_model('mcp');
		controller::get_object('mcp')->stdio();
		exit(0);

	case 'serve':
		$port = isset($options['port']) ? (int)$options['port'] : 8000;
		$host = isset($options['host']) ? $options['host'] : 'localhost';
		echo "Raster is running at http://$host:$port (Ctrl+C to stop)\n";
		passthru(escapeshellarg(PHP_BINARY).' -S '.escapeshellarg("$host:$port").' -t '.escapeshellarg($root).' '.escapeshellarg($root.'/index.php'), $status);
		exit($status);

	case 'render':
		// renders a URL without a web server, handy for tests and agents
		$uri = isset($positional[0]) ? $positional[0] : '/';
		$url = parse_url(getenv('RASTER_URL') ?: 'http://localhost:8000/');
		$_SERVER['HTTP_HOST'] = $url['host'].(isset($url['port']) ? ':'.$url['port'] : '');
		if (isset($url['scheme']) && $url['scheme'] === 'https') $_SERVER['HTTPS'] = 'on';
		$prefix = rtrim(isset($url['path']) ? $url['path'] : '', '/');
		$_SERVER['SCRIPT_NAME'] = $prefix.'/index.php';
		$_SERVER['REQUEST_URI'] = $prefix.'/'.ltrim($uri, '/');
		$_SERVER['REQUEST_METHOD'] = 'GET';
		chdir($root);
		// exit status 1 for 4xx/5xx responses (missing page, template errors)
		register_shutdown_function(function () {
			$status = http_response_code();
			if ($status && $status >= 400) {
				fwrite(STDERR, "HTTP $status\n");
				exit(1);
			}
		});
		boot::up();
		exit(0);

	default:
		echo <<<HELP
Raster command line

  php bin/raster serve [--port=8000]     run the site with PHP's built in server
  php bin/raster lint [--json]           check every view for annotation errors
  php bin/raster schema [--json]         compare the templates' content model with the database
        --apply                          create missing tables and columns (needed when frozen)
        --check                          exit with 1 when they differ (for CI)
        --rename=table.old:new           rename a column after renaming an annotation
        --drop=table.column              delete a column no template uses
        --drop=table                     delete a table no template uses
  php bin/raster user <email|name> [--password=...] [--role=admin|editor|member]
                                         create a user or reset a password
  php bin/raster users                   list users
  php bin/raster send <url> [--to=email] [--dry-run] [--again]
                                         email a page to newsletter subscribers
  php bin/raster mcp                     MCP server over stdio for local agents
  php bin/raster render <url>            print the HTML of a URL
  php bin/raster doctor [--json]         check the project: PHP, versions, edited framework
                                         files, templates, database, deprecations, production
  php bin/raster new <folder>            start a new site from this copy of Raster
  php bin/raster update [latest|2.1.0|<branch>|<folder>|<file.tar.gz>] [--dry-run] [--force]
                                         replace the framework files with another release,
                                         then upgrade every app
  php bin/raster upgrade [--dry-run]     run the upgrade steps this app still needs
  php bin/raster version                 the framework's version and each app's

Set RASTER_ENV=production to run against the production database.

HELP;
		exit($command === 'help' ? 0 : 2);
}
